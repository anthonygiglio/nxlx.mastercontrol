#!/usr/bin/env python3
# SPDX-FileCopyrightText: 2026 NXLX.Systems and contributors
# SPDX-License-Identifier: Apache-2.0
"""nxlx-convert: move a node's live state from the old pocketvj names to the NXLX names, once, at the cutover.

    sudo nxlx-convert --plan         what it would do, and what stops it; changes nothing (the default)
    sudo nxlx-convert --run          convert: back up, arm a 15 minute undo, stop, rename, rewrite, start, check
    sudo nxlx-convert --confirm      keep the conversion: disarm the undo (the backup stays)
    sudo nxlx-convert --undo         walk the journal backwards and start the old names again
    nxlx-convert --root DIR ...      stage mode: work on a copy of a node in DIR (tests); no accounts tools,
                                     no systemctl, no timer, nothing outside DIR

The rename plan is rename-pvj-assessment.md, PR 2 and section 4; the names are those of tools/rename-map.txt
(D135; the rows a node needs are copied into TABLE below and a test keeps the two equal); decision D136.

What it converts: the service accounts and their groups (the shared group pvj becomes nxlx-svc), the deploy and
login account pvj-dev (last, and only when nobody is logged in as it), the folders /opt/pvj, /opt/pvj-ndi,
/opt/pvj-ndi-server, /var/lib/pvj and its siblings, /etc/pvj (pvj.env becomes nxlx.env), /media/pvj, the unit
files with their drop-ins and wants links, sudoers, udev, tmpfiles, journald and modules-load files, the command
links in /usr/local/bin, and the text files it owns (install.json, nxlx.env, allowed_signers, support.json, the
release's "previous" note). User and group ids stay, so every file keeps its owner and nothing is chowned; the
settings, the node id, the certificates and the pairing hashes are carried over byte for byte (checked). Nobody is
signed out by the conversion: the paired devices' tokens are hashes in settings.json, which is not touched.

What it never does: delete anything (leftovers are listed, and move with their folder), touch the videos (only
their parent folder is renamed, on the same file system), touch /run (rebuilt at boot), or run while a show is
playing, an update is running, the root file system is read-only or a USB drive is mounted under /media/pvj.
--force overrides only the show check.

The undo timer is a unit file in /etc (nxlx-convert-undo.timer, enabled), so it also fires five minutes after a
restart: a node that loses power half-way comes back to the old names by itself. A run that carries on re-arms it.

Idempotent: the plan is worked out from what is on the node, so a second run finds nothing to do and a run that
stopped half-way finishes with --run or goes back with --undo. Every change is written to the journal
/var/backups/nxlx-convert/journal.jsonl before and after it is made, with the original of every rewritten file.

Standard library only, so it runs before anything else of the new release is in place.
"""
import argparse
import datetime
import fcntl
import hashlib
import json
import os
import re
import shutil
import socket
import stat
import subprocess
import sys
import tarfile

# The rows of tools/rename-map.txt a node's files can hold (kinds system, env and release, and the package folder
# in a path). old, new, kind; the matching rules are the table's (see its header).
TABLE = r"""
