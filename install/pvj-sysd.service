[Unit]
Description=nxlx.mastercontrol system helper (reboot, power off, set the clock)
StartLimitIntervalSec=0

[Service]
# Root, but with no capabilities of its own: it only asks systemd (reboot, poweroff) and systemd-timedated
# (set the clock) over D-Bus, and answers only root and pvj-web on its socket.
User=root
Group=pvj
UMask=0027
# Its own folder, root:pvj 0750: members of group pvj can reach the socket but cannot replace it.
RuntimeDirectory=pvj-sysd
RuntimeDirectoryMode=0750
Environment=PVJ_SYSD_DIR=/run/pvj-sysd
ExecStart=@PVJ_DIR@/bin/pvj-sysd
Restart=always
RestartSec=2

CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# The stats overlay (D133) reads the firmware's throttling word with `vcgencmd get_throttled`, which opens /dev/vcio (root only, 0600).
# A private /dev has no such file, so the device policy stands in for PrivateDevices: nothing but /dev/vcio beyond the standard pseudo
# devices (null, zero, random and the like). On a board with no /dev/vcio the entry matches nothing.
DevicePolicy=closed
DeviceAllow=/dev/vcio rw
# D127: the one avahi service file that announces the node to the local network (pvj/FLEET.md). D128: the Pi's boot files, for the AV output choice.
# "-": no error where avahi is not installed or the boot folder is not there.
ReadWritePaths=/run/pvj-sysd -/etc/avahi/services -/boot/firmware
PrivateNetwork=yes
IPAddressDeny=any
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectProc=invisible
RemoveIPC=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
