[Unit]
Description=nxlx.mastercontrol web panel and control API
After=network.target pvj-player.service
Wants=pvj-player.service
StartLimitIntervalSec=0

[Service]
# Talks to the player only through its socket in /run/pvj/player (group "pvj"); it has
# no access to the screen. The devices it uses are USB MIDI controllers (/dev/snd/midi*,
# group "audio"), for the optional MIDI module: read for the controls, write for the lights.
# The device policy below cannot tell a MIDI node from the other ALSA nodes (see D53).
User=pvj-web
Group=pvj
# audio: USB MIDI controllers; video: live input from a USB capture device (read by a helper this service starts)
SupplementaryGroups=audio video
UMask=0007
# Its own folder: the PIN, the live-input pipe, and the overlay, shader and mapping files it hands to the player
# (which reads them through group "pvj" and cannot change them). No other unit may name this folder (D45).
# Kept across stops: the undervoltage note lasts until the next boot (an upgrade from before D45 loses it), and
# pvj-tmpfiles.conf keeps two links in it.
RuntimeDirectory=pvj/web
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
# PVJ_RUNTIME_DIR is always the folder this service itself writes; the others say where its peers are.
Environment=PVJ_RUNTIME_DIR=/run/pvj/web
Environment=PVJ_PLAYER_DIR=/run/pvj/player
Environment=PVJ_NETD_DIR=/run/pvj/netd
Environment=PVJ_STATE_DIR=/var/lib/pvj
Environment=PVJ_BIND=0.0.0.0
Environment=PVJ_PORT=80
EnvironmentFile=-/etc/pvj/pvj.env
ExecStart=@PVJ_DIR@/bin/pvj-web
Restart=always
RestartSec=1
# A live-input helper started by this service goes with it (it stays in the service's control group).
KillMode=control-group

# Sandbox
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Not PrivateDevices: that would hide /dev/snd/midi*. The device policy allows only the basic
# devices, ALSA devices and capture devices. "char-alsa rw" (it was "r" until D53) lets the
# panel light a known MIDI controller's buttons. It is every ALSA node, not only MIDI ones:
# systemd can name a class of devices or one fixed node, and a controller's node appears when
# it is plugged in. The program itself opens only /dev/snd/midiC<n>D<n> of a controller that
# matched a profile, and writes only the fixed messages of that profile (pvj/midi.py).
DevicePolicy=closed
DeviceAllow=/dev/null rw
DeviceAllow=/dev/zero rw
DeviceAllow=/dev/full rw
DeviceAllow=/dev/random r
DeviceAllow=/dev/urandom r
DeviceAllow=char-alsa rw
DeviceAllow=char-video4linux rw
ReadWritePaths=/var/lib/pvj /run/pvj/web
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_NETLINK: reading the box's own addresses (`ip -j addr`) for the Network card and the join QR codes. Without it both
# silently showed no address on a real Pi 4 (2026-09-30).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
