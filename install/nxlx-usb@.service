[Unit]
Description=Mount USB drive %I for nxlx.mastercontrol
# Stops (and unmounts) when the device disappears.
BindsTo=dev-%i.device
After=dev-%i.device

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/nxlx/nxlx.env
ExecStart=@NXLX_DIR@/bin/nxlx-usb mount /dev/%I
# The node's clip stick is checked with fsck.exfat before it is mounted (D143); a large stick can take minutes.
TimeoutStartSec=15min
ExecStop=@NXLX_DIR@/bin/nxlx-usb unmount /dev/%I
# Also after a start that was killed (stick pulled or time limit during the clip stick's check), when ExecStop does
# not run: the clip stick's status and any mount of this device go (D143). Unmounting twice is harmless.
ExecStopPost=-@NXLX_DIR@/bin/nxlx-usb unmount /dev/%I
