[Unit]
Description=nxlx.mastercontrol player (mpv)
# Not After=multi-user.target: this unit is WantedBy=multi-user.target (a target waits for what it wants) and
# pvj-web is ordered after this unit, so that made a cycle and systemd silently deleted the start job. Found on a
# real Pi 4 (2026-09-30). Not udev-settle either (deprecated, and slow); Restart=always covers a display that is
# not ready yet.
After=local-fs.target systemd-udevd.service
StartLimitIntervalSec=0

[Service]
# The installer replaces @PVJ_USER@ with the account that owns the screen and
# sound card, and @PVJ_DIR@ with the install directory.
User=@PVJ_USER@
Group=pvj
# pvj-ndi: to read the picture from the NDI helper's pipe (D61); the helper itself is not in group pvj
SupplementaryGroups=video render audio input pvj-ndi
# Its own folder for the control socket and the preview picture: only this account can create, replace or remove
# anything in it; group "pvj" (the panel) can reach the socket. No other unit may name this folder: systemd gives
# a RuntimeDirectory to the unit that starts, so a shared one ends up owned by whoever started last (D45).
# The parent /run/pvj stays root's (systemd creates it root:root 0755; see pvj-tmpfiles.conf).
RuntimeDirectory=pvj/player
RuntimeDirectoryMode=0750
UMask=0007
EnvironmentFile=-/etc/pvj/pvj.env
Environment=PVJ_RUNTIME_DIR=/run/pvj/player
ExecStart=@PVJ_DIR@/bin/pvj-player serve
# A crashed or wedged player comes back on its own, mid-gig.
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
