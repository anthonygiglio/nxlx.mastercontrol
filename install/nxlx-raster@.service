[Unit]
Description=nxlx.mastercontrol picture helper (one uploaded picture, then it exits; D129)
ConditionPathExists=@NXLX_DIR@/render/nxlx-raster

[Service]
# Started by nxlx-raster.socket for each connection, with the connection as its standard input and output. It reads one
# PNG, JPEG or SVG and writes one clean PNG (design/text-and-logo-sources_2026-11-08.md section 7). This is the one
# part that decodes a file from a phone or a laptop (and, since slice 2, draws a text with a bundled font: the fonts are read
# from the release's own folder, which is read-only here, by a name the program checks), and C decoders have a long history of memory bugs, so it is given
# nothing: its own account, no network, none of the box's files, no way to gain rights, a syscall list, and hard ceilings.
User=nxlx-raster
Group=nxlx-raster
UMask=0077
StandardInput=socket
StandardOutput=socket
StandardError=journal
Environment=HOME=/nonexistent
# The fonts are in mctl/fonts, or in pvj/fonts in a release from before the rename. A rollback only repoints
# "current" and does not write this file again, so the unit looks at which one the current release has (for one
# release; $$ is a $ for systemd).
ExecStart=/bin/sh -c 'f=@NXLX_DIR@/mctl/fonts; [ -d "$$f" ] || f=@NXLX_DIR@/pvj/fonts; exec @NXLX_DIR@/render/nxlx-raster --fonts "$$f"'
# A job that is not done in 15 seconds is killed from outside as well as by the program's own alarm.
RuntimeMaxSec=15

# Sandbox. No capabilities, no network (it keeps the connection it was given and can make no other), a read-only
# system, no home, no devices, no sight of the settings, the PIN or any other service's folder.
CapabilityBoundingSet=
NoNewPrivileges=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
InaccessiblePaths=-/var/lib/nxlx -/var/lib/nxlx-player -/etc/nxlx -/run/nxlx -/run/nxlx-sound -/run/nxlx-ndi -/run/nxlx-sysd -/run/nxlx-supportd -/run/nxlx-link -/media
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# What a decoder needs (read, write, memory, signals, the timer) and not what a hijacked one would want: no
# privileged calls, no limits to raise, no sockets of its own, no shared memory with others, no keyring.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @network-io @ipc @keyring @chown @setuid
# Ceilings. The address space and CPU limits are the design's (512 MB, 10 s); the memory limit is the unit's as a whole.
LimitAS=512M
LimitCPU=10
LimitNOFILE=16
LimitCORE=0
MemoryMax=256M
MemorySwapMax=0
TasksMax=2
