[Unit]
Description=nxlx.mastercontrol web panel and control API
After=network.target nxlx-player.service
Wants=nxlx-player.service
StartLimitIntervalSec=0

[Service]
# Talks to the player only through its socket in /run/nxlx/player (group "nxlx-svc"); it has
# no access to the screen. The devices it uses are USB MIDI controllers (/dev/snd/midi*,
# group "audio"), for the optional MIDI module: read for the controls, write for the lights.
# The device policy below cannot tell a MIDI node from the other ALSA nodes (see D53).
User=nxlx-web
Group=nxlx-svc
# audio: USB MIDI controllers; video: live input from a USB capture device (read by a helper this service starts)
SupplementaryGroups=audio video
UMask=0007
# Its own folder: the PIN, the live-input pipe, and the overlay, shader and mapping files it hands to the player
# (which reads them through group "nxlx-svc" and cannot change them). No other unit may name this folder (D45).
# Kept across stops: the undervoltage note lasts until the next boot (an upgrade from before D45 loses it), and
# nxlx-tmpfiles.conf keeps two links in it.
RuntimeDirectory=nxlx/web
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
# NXLX_RUNTIME_DIR is always the folder this service itself writes; the others say where its peers are.
Environment=NXLX_RUNTIME_DIR=/run/nxlx/web
Environment=NXLX_PLAYER_DIR=/run/nxlx/player
Environment=NXLX_NETD_DIR=/run/nxlx/netd
Environment=NXLX_STATE_DIR=/var/lib/nxlx
Environment=NXLX_BIND=0.0.0.0
Environment=NXLX_PORT=80
# The same panel over TLS, once the owner has uploaded a certificate (D79, docs/HTTPS.md); the key lives in
# /var/lib/nxlx/tls, made 0700 by this service's account. Port 443 is covered by CAP_NET_BIND_SERVICE like port 80.
Environment=NXLX_HTTPS_PORT=443
# The port the nodes call each other on (D132): TLS that asks every caller for a certificate from the pinned root. Not a panel,
# the same number on every node. Unlike 443 it needs no privilege.
Environment=NXLX_PEER_PORT=8443
EnvironmentFile=-/etc/nxlx/nxlx.env
ExecStart=@NXLX_DIR@/bin/nxlx-web
Restart=always
RestartSec=1
# A live-input helper started by this service goes with it (it stays in the service's control group).
KillMode=control-group

# Sandbox
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Not PrivateDevices: that would hide /dev/snd/midi*. The device policy allows only the basic
# devices, ALSA devices and capture devices. "char-alsa rw" (it was "r" until D53) lets the
# panel light a known MIDI controller's buttons. It is every ALSA node, not only MIDI ones:
# systemd can name a class of devices or one fixed node, and a controller's node appears when
# it is plugged in. The program itself opens only /dev/snd/midiC<n>D<n> of a controller that
# matched a profile, and writes only the fixed messages of that profile (mctl/midi.py).
DevicePolicy=closed
DeviceAllow=/dev/null rw
DeviceAllow=/dev/zero rw
DeviceAllow=/dev/full rw
DeviceAllow=/dev/random r
DeviceAllow=/dev/urandom r
DeviceAllow=char-alsa rw
DeviceAllow=char-video4linux rw
# -/media/nxlx-clips: the clips folder of the node's own clip stick, bound there by nxlx-usb (D143); the rest of that
# stick and every other stick stay read-only.
ReadWritePaths=/var/lib/nxlx /run/nxlx/web -/media/nxlx-clips
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_NETLINK: reading the box's own addresses (`ip -j addr`) for the Network card and the join QR codes. Without it both
# silently showed no address on a real Pi 4 (2026-09-30).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
