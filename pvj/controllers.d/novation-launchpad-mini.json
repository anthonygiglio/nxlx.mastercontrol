  "lights": {
    "default": true,
    "unverified": false,
    "note": "The pads of the three banks are amber (A), yellow-green (B) and orange (C) where a pad holds something; the one that plays is bright green; an empty pad is dark. Elsewhere amber: there is something here; green: it is on now. Red: this darkens the screen; bright red: the screen is dark; the fade button flashes red while the picture goes down and while it is black. The messages are from Novation's reference for the Launchpad S; that the Mini takes the same ones is not confirmed by Novation and has not been seen on a real one yet: press Test lights and say what you see.",
    "sources": ["Novation, Launchpad S Programmer's Reference Manual 1.02 (https://fael-downloads-prod.focusrite.com/customer/dev/s3fs-public/novation/downloads/10753/launchpad-s-prm.pdf), read in full by the reviewer of pull request #82: a note-on on channel 1 per pad, red in bits 0 to 1 and green in bits 4 to 5 of the velocity, off is 0Ch (so 16 x green + red + 12)", "The same manual: control changes 68h to 6Fh for the top row, with the same value; B0h 00h 00h turns all LEDs off and restores the power-on settings", "Not confirmed from a primary source: that the original Launchpad Mini (USB id 1235:0036) uses the Launchpad S protocol. It is widely reported and the recording of the owner's unit fits its key numbers", "The same manual, 'Adventures in Double Buffering' and 'Example: Flashing LEDs': B0h 00h 28h is flash mode (the display buffer swaps every 280 ms), a colour written in copy mode (bits 3 and 2 set, as every value here is) stays lit, and the same colour with bit 2 cleared (the value less 4) flashes; so flashing full red is 0Fh less 4, 0Bh (11)"],
    "channel": 1,
    "brightness": true,
    "off": 12,
    "setup": [[176, 0, 0], [176, 0, 40]],
    "clear": [[176, 0, 0]],
    "styles": {
      "clip": {"low": {"off": 12, "on": 29, "active": 60, "busy": 60}, "medium": {"off": 12, "on": 29, "active": 60, "busy": 60}, "high": {"off": 12, "on": 46, "active": 60, "busy": 60}},
      "clip_b": {"low": {"off": 12, "on": 45, "active": 60, "busy": 60}, "medium": {"off": 12, "on": 45, "active": 60, "busy": 60}, "high": {"off": 12, "on": 62, "active": 60, "busy": 60}},
      "clip_c": {"low": {"off": 12, "on": 30, "active": 60, "busy": 60}, "medium": {"off": 12, "on": 30, "active": 60, "busy": 60}, "high": {"off": 12, "on": 47, "active": 60, "busy": 60}},
      "preset": {"low": {"off": 12, "on": 29, "active": 28, "busy": 28}, "medium": {"off": 12, "on": 29, "active": 44, "busy": 44}, "high": {"off": 12, "on": 46, "active": 60, "busy": 60}},
      "control": {"low": {"off": 12, "on": 29, "active": 29, "busy": 29}, "medium": {"off": 12, "on": 29, "active": 29, "busy": 29}, "high": {"off": 12, "on": 46, "active": 46, "busy": 46}},
      "vibes": {"low": {"off": 12, "on": 29, "active": 28, "busy": 28}, "medium": {"off": 12, "on": 29, "active": 44, "busy": 44}, "high": {"off": 12, "on": 46, "active": 60, "busy": 60}},
      "effect": {"low": {"off": 12, "on": 29, "active": 28, "busy": 28}, "medium": {"off": 12, "on": 29, "active": 44, "busy": 44}, "high": {"off": 12, "on": 46, "active": 60, "busy": 60}},
      "set": {"low": {"off": 12, "on": 29, "active": 28, "busy": 28}, "medium": {"off": 12, "on": 29, "active": 44, "busy": 44}, "high": {"off": 12, "on": 46, "active": 60, "busy": 60}},
      "step": {"low": {"off": 12, "on": 29, "active": 29, "busy": 29}, "medium": {"off": 12, "on": 29, "active": 29, "busy": 29}, "high": {"off": 12, "on": 46, "active": 46, "busy": 46}},
      "play": {"low": {"off": 12, "on": 29, "active": 28, "busy": 29}, "medium": {"off": 12, "on": 29, "active": 44, "busy": 29}, "high": {"off": 12, "on": 46, "active": 60, "busy": 46}},
      "stop": {"low": {"off": 12, "on": 13, "active": 12, "busy": 12}, "medium": {"off": 12, "on": 13, "active": 12, "busy": 12}, "high": {"off": 12, "on": 14, "active": 12, "busy": 12}},
